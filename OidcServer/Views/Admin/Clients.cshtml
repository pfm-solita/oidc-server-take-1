@{
    ViewData["Title"] = "Manage Clients";
    Layout = "_Layout";
    var clients = ViewData["Clients"] as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}
<h1>OAuth Clients</h1>
<a href="/admin/clients/create" class="btn" style="margin-bottom:16px;display:inline-block;">+ New Client</a>
<div class="card">
    <table>
        <thead>
            <tr>
                <th>Client ID</th>
                <th>Display Name</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                <tr>
                    <td>@client.ClientId</td>
                    <td>@client.DisplayName</td>
                    <td>@client.Type</td>
                    <td>
                        <form method="post" action="/admin/clients/delete" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clientId" value="@client.ClientId" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this client?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<a href="/admin" style="margin-top:16px;display:inline-block;">&#8592; Back to Dashboard</a>
