@using OidcServer.Models
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
    var externalProviders = ViewData["ExternalProviders"] as IEnumerable<ExternalProvider> ?? Enumerable.Empty<ExternalProvider>();
}
<div class="card">
    <h1>Sign In</h1>
    <partial name="_ValidationSummary" />
    <form method="post" action="/account/login">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autofocus />
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="btn">Sign In</button>
        <a href="/account/register" style="margin-left:16px;">Create account</a>
    </form>
    @if (externalProviders.Any())
    {
        <hr style="margin:24px 0;" />
        <p style="margin-bottom:12px;color:#666;">Or sign in with:</p>
        @foreach (var provider in externalProviders)
        {
            <a href="/account/external-login?provider=@Uri.EscapeDataString(provider.Name)&returnUrl=@Uri.EscapeDataString((string?)ViewData["ReturnUrl"] ?? string.Empty)"
               class="btn btn-secondary" style="margin-right:8px;margin-bottom:8px;">
                @provider.DisplayName
            </a>
        }
    }
</div>
